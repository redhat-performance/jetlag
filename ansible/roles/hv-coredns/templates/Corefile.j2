# Jetlag HV CoreDNS Configuration
. {
    errors
    # log
{% if controlplane_network[0] | ansible.utils.ipv4 %}
    forward . {{ labs[lab]['dns'][0] }}
{% endif %}
    cache 30
    reload

    import Corefile.hosts
    # Drop-in files must use .conf extension and must not contain a hosts block
    import /etc/coredns/conf.d/*.conf
}
